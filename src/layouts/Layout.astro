---
import "../styles/global.css";
const { title = "TP2 Penguins" } = Astro.props;

---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | TP3 Penguins</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">TP3 <span>Data</span></a>
      <label class="site-selector">
        <span>Pages</span>
        <select id="species" aria-label="Choisir une page">
          <option value="/">Accueil</option>
          <option value="/simple/">Simple</option>
          <option value="/penguins/">Simple Penguin</option>
          <option value="/penguins-filter/">Penguin avec filtre</option>
          <option value="/penguins-filters/">Penguin avec plusieurs filtres</option>
          <option value="/cachalots/">Cachalots</option>
          <option value="/species/">Slider</option>
          <option value="/species-tabs/">Onglets accessibles</option>
        </select>
      </label>
      <nav class="comparison-navigation" aria-label="Choisir un comparatif">
        <label class="site-selector">
          <span>Manchots</span>
          <select id="penguins-comparison" aria-label="Choisir un manchot">
            <option value="" selected disabled>Comparer une espèce</option>
            <option value="/species/Adelie/">Adelie</option>
            <option value="/species/Chinstrap/">Chinstrap</option>
            <option value="/species/Gentoo/">Gentoo</option>
          </select>
        </label>
        <label class="site-selector">
          <span>Cétacés</span>
          <select id="cetaceans-comparison" aria-label="Choisir un cétacé">
            <option value="" selected disabled>Comparer un cétacé</option>
            <option value="/species/Orques/">Orques</option>
            <option value="/species/Cachalots/">Cachalots</option>
          </select>
        </label>
      </nav>
    </header>
    <main><slot /></main>
    <footer>TP3 R312</footer>
  </body>
</html>

<script>
  const pageSelect = document.querySelector("#species");

  if (pageSelect instanceof HTMLSelectElement) {
    pageSelect.value = location.pathname;
  }

  pageSelect?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    location.pathname = value;
  });

  const penguinsSelect = document.querySelector("#penguins-comparison");
  penguinsSelect?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    location.pathname = value;
  });

  const cetaceansSelect = document.querySelector("#cetaceans-comparison");
  cetaceansSelect?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    location.pathname = value;
  });
</script>

