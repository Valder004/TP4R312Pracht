---
import { JSDOM } from "jsdom";
import penguins from "../assets/penguins.json";

const { species, type = "mass", options = {} } = Astro.props;
const data = species ? penguins.filter(p => p.species === species) : penguins;
const dom = new JSDOM("<!doctype html><html><body></body></html>");
globalThis.document = dom.window.document;
const Plot = await import("@observablehq/plot");

const chartDefaults = {
  mass: {
    x: "culmen_length_mm",
    y: "body_mass_g",
    xLabel: "Longueur du bec (mm)",
    yLabel: "Masse corporelle (g)",
  },
  flipper: {
    x: "sex",
    y: "body_mass_g",
    xLabel: "Sexe",
    yLabel: "Masse corporelle (g)",
  },
  bill: {
    x: "island",
    y: "count",
    xLabel: "Île",
    yLabel: "Nombre de manchots",
  },
};
const chartType = chartDefaults[type as keyof typeof chartDefaults] ?? chartDefaults.mass;
const marks = options.marks ?? (type === "flipper"
  ? [Plot.boxY(data, { x: "sex", y: "body_mass_g", fill: "sex" })]
  : type === "bill"
    ? [Plot.barY(data, Plot.groupX({ y: "count" }, { x: "island", fill: "island" }))]
    : [Plot.dot(data, { x: "culmen_length_mm", y: "body_mass_g", fill: "sex", title: d => `${d.island} (${d.sex})` })]);

const chart = Plot.plot({
  ...options,
  document: dom.window.document,
  marks,
  x: options.x ?? { label: chartType.xLabel, grid: true },
  y: options.y ?? { label: chartType.yLabel, grid: true },
  color: options.color ?? { legend: true }
});
---

<div class="plot-frame" set:html={chart.outerHTML}></div>

